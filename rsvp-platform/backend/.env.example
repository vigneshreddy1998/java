# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/rsvp_platform
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173

# Admin auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRATION_MINUTES=720
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-on-first-login

# AI chat widget (flight-detail extraction) — leave blank to disable and always fall back
# to the manual form.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
